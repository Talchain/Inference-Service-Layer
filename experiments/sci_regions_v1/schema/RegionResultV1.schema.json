{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olumi.example/research/sci-regions/RegionResultV1",
  "title": "RegionResultV1 (offline research only)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request", "request_sha256", "manifest", "points", "transition_brackets", "metrics", "reference", "errors", "unrun_checks"],
  "properties": {
    "schema_version": {"const": "RegionResultV1"},
    "request": {"type": "object"},
    "request_sha256": {"$ref": "#/definitions/hash"},
    "manifest": {"type": "object", "additionalProperties": false, "required": ["actual_evaluations", "budget_exhausted", "source_verified", "execution_status", "python", "numpy"], "properties": {"actual_evaluations": {"type": "integer", "minimum": 0}, "budget_exhausted": {"type": "boolean"}, "source_verified": {"type": "boolean"}, "execution_status": {"enum": ["COMPLETE", "PARTIAL", "REFUSED"]}, "python": {"type": "string"}, "numpy": {"type": "string"}}},
    "points": {"type": "array", "items": {"$ref": "#/definitions/point"}},
    "transition_brackets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["axis_id", "fixed_axis_value", "low", "high", "width", "kinds", "coverage_kind"], "properties": {"axis_id": {"type": "string"}, "fixed_axis_value": {"type": "number"}, "low": {"type": "number"}, "high": {"type": "number"}, "width": {"type": "number", "minimum": 0}, "kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["GOAL", "FEASIBILITY", "PREFERENCE"]}}, "coverage_kind": {"const": "TRANSITION_BRACKET"}}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["confusion", "false_feasible", "false_confident_preference", "abstentions", "incomplete_whole_comparison", "topology_failures", "boundary_error"], "properties": {"confusion": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "false_feasible": {"type": ["integer", "null"], "minimum": 0}, "false_confident_preference": {"type": ["integer", "null"], "minimum": 0}, "abstentions": {"type": "integer", "minimum": 0}, "incomplete_whole_comparison": {"type": "integer", "minimum": 0}, "topology_failures": {"type": "array", "items": {"type": "string"}}, "boundary_error": {"type": ["number", "null"]}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["status", "baseline_identity", "matched_assumptions", "notes"], "properties": {"status": {"enum": ["PINNED_LOCAL", "UNAVAILABLE"]}, "baseline_identity": {"type": ["string", "null"]}, "matched_assumptions": {"type": "boolean"}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "errors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"type": "string"}, "detail": {"type": "string"}}}},
    "unrun_checks": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "constraint": {"type": "object", "additionalProperties": false, "required": ["id", "state", "value", "margin"], "properties": {"id": {"type": "string"}, "state": {"enum": ["SATISFIED", "VIOLATED", "UNRESOLVED", "UNSUPPORTED", "NOT_APPLICABLE"]}, "value": {"type": ["number", "null"]}, "margin": {"type": ["number", "null"]}}},
    "option": {"type": "object", "additionalProperties": false, "required": ["goal", "goal_value", "constraints", "feasibility", "objective_value", "reason", "tier"], "properties": {"goal": {"enum": ["ATTAINED", "MISSED", "UNSUPPORTED", "NOT_APPLICABLE"]}, "goal_value": {"type": ["number", "null"]}, "constraints": {"type": "array", "items": {"$ref": "#/definitions/constraint"}}, "feasibility": {"enum": ["FEASIBLE", "INFEASIBLE", "FEASIBILITY_UNRESOLVED", "UNSUPPORTED"]}, "objective_value": {"type": ["number", "null"]}, "reason": {"type": ["string", "null"]}, "tier": {"type": ["string", "null"]}}},
    "pair": {"type": "object", "additionalProperties": false, "required": ["state", "difference", "interval", "numeric_policy", "interval_kind"], "properties": {"state": {"enum": ["EXACT_TIE", "A_PREFERRED", "B_PREFERRED", "A_POINT_PREFERRED", "B_POINT_PREFERRED", "PRACTICALLY_EQUIVALENT", "NUMERICALLY_UNRESOLVED"]}, "difference": {"type": "number"}, "interval": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}, "numeric_policy": {"enum": ["EXACT_RATIONAL", "FLOAT64_RECORDED"]}, "interval_kind": {"enum": ["EXACT_VALUE", "HEURISTIC_ROUNDOFF_SCREEN"]}}},
    "question": {"type": ["object", "null"], "additionalProperties": false, "required": ["kind", "evidence_id", "text"], "properties": {"kind": {"enum": ["MISSING_INFORMATION", "CONSTRAINT", "PREFERENCE"]}, "evidence_id": {"type": "string"}, "text": {"type": "string"}}},
    "point": {"type": "object", "additionalProperties": false, "required": ["x", "y", "state", "coverage_kind", "options", "comparison_completeness", "named_preference", "overall_preference", "pairwise", "question"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "state": {"enum": ["EVALUATED", "NOT_EVALUATED", "OUTSIDE_DECLARED_DOMAIN", "EVALUATION_FAILED", "MODEL_IDENTITY_MISMATCH", "UNSUPPORTED_SEMANTICS"]}, "coverage_kind": {"enum": ["EVALUATED_POINTS_ONLY", "NONE"]}, "options": {"type": "object", "additionalProperties": {"$ref": "#/definitions/option"}}, "comparison_completeness": {"enum": ["COMPLETE", "INCOMPLETE_COMPARISON", "NOT_EVALUATED"]}, "named_preference": {"type": "string"}, "overall_preference": {"type": "string"}, "pairwise": {"type": "object", "additionalProperties": {"$ref": "#/definitions/pair"}}, "question": {"$ref": "#/definitions/question"}}}
  }
}
